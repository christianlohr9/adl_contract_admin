# =============================================================================
# ADL Contract Admin — Environment Variables
# Copy to .env and fill in real values before running.
# =============================================================================

# --- Application ---
APP_NAME=ADL Contract Admin
DEBUG=true

# --- Database ---
# Use "db" as host when running via docker-compose, "localhost" for local dev.
DATABASE_URL=postgresql+asyncpg://adl:adl_dev@db:5432/adl

# --- CORS ---
# Comma-separated list of allowed origins for browser requests.
CORS_ORIGINS=http://localhost:5173

# --- MFL API ---
MFL_LEAGUE_ID=60206
MFL_YEAR=2026
MFL_API_KEY=
MFL_USERNAME=your_username
MFL_PASSWORD=your_password
MFL_BASE_URL=https://api.myfantasyleague.com
MFL_REQUEST_DELAY=1.0
MFL_BACKFILL_REQUEST_DELAY=6.0

# --- Sync Scheduler ---
SYNC_INTERVAL_HOURS=6
SYNC_ENABLED=true
SYNC_HISTORICAL_YEARS=[2020,2021,2022,2023,2024,2025]
